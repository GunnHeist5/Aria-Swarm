# Reachwell Orchestrator — configuration template.
# Copy to .env and fill in. NOTHING here is optional-by-accident: unset secrets
# fail closed (the affected subsystem refuses to run rather than guessing).
# Never commit a filled-in .env; never log any of these values.

# ---------------------------------------------------------------------------
# Phase gate — deliverables ship in order and the code enforces it.
#   1 = DRY RUN only (sync + plan + CSV; zero calls placed)
#   2 = LIVE, SMALL (second-touch slice only, concurrency clamped to 2)
#   3 = FULL       (requires TRUST_HUB_CONFIRMED=true)
PHASE=1
TRUST_HUB_CONFIRMED=false
PHASE2_MAX_CONTACTS=50
PHASE2_MAX_CONCURRENCY=2

# ---------------------------------------------------------------------------
# JustCall (contact database + event source) — Sales Dialer API v2.1
JUSTCALL_API_KEY=
JUSTCALL_API_SECRET=
JUSTCALL_CAMPAIGN_ID=3310579
# Secret for verifying JustCall "Send Data to Webhook" SHA256 signatures.
JUSTCALL_WEBHOOK_SECRET=
# Company name lives in custom_fields; the exact key is discovered on first
# sync and stored. Set this only to override the discovered mapping.
JUSTCALL_COMPANY_FIELD_KEY=
# Post-call dispositions (comma separated) that qualify a rep-worked contact
# for an AI second touch.
JUSTCALL_QUALIFYING_DISPOSITIONS=Interested,Callback,No Answer

# ---------------------------------------------------------------------------
# Voice provider (swappable; twilio is the only implementation so far)
VOICE_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public HTTPS base for webhooks/TwiML/ConversationRelay websocket, e.g.
# https://dialer.reachwell.example — required for live phases.
PUBLIC_BASE_URL=
MAX_CALL_MINUTES=10
AMD_ENABLED=false

# ---------------------------------------------------------------------------
# LLM behind ConversationRelay (bring-our-own-LLM)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
# Falls back to ANTHROPIC_API_KEY if unset.
LLM_API_KEY=
# low keeps voice latency tight; raise if conversation quality needs it.
LLM_EFFORT=low
LLM_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# Storage
DATABASE_URL=postgresql://orchestrator:orchestrator@localhost:5432/orchestrator
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Pacing & concurrency
MAX_CONCURRENT_CALLS=5
CONCURRENCY_HARD_CEILING=8
CALLS_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Number pool & local presence
PER_NUMBER_DAILY_CAP=150
NUMBER_COOLDOWN_SECONDS=120
# Dials/day allowed on a number aged N days (ramp before full volume).
RAMP_SCHEDULE=10,25,50,100,150
# Bench a number whose connect rate falls below this fraction of pool average.
BENCH_RELATIVE_THRESHOLD=0.5
BENCH_MIN_DIALS=30
AREA_CODE_TARGETS_PATH=config/area_code_targets.example.json

# ---------------------------------------------------------------------------
# Compliance — these are hard blocks, not warnings.
# Calling window in the PROSPECT's local time (derived from area code).
CALL_WINDOW_START=09:00
CALL_WINDOW_END=17:00
STATE_WINDOWS_PATH=config/state_windows.json
TWO_PARTY_STATES_PATH=config/two_party_states.json
# Path to the federal DNC scrub list (one number per line, 10-digit or E.164).
# UNSET = every dial is blocked with reason DNC_SOURCE_MISSING. Fail closed.
DNC_LIST_PATH=
# Consent basis is REQUIRED per contact with NO default. Unset = contacts sync
# but are never dialable. Set deliberately, e.g. "prior_express_consent" or
# "established_business_relationship" — and be able to prove it.
CONSENT_BASIS_FIRST_TOUCH=
CONSENT_BASIS_SECOND_TOUCH=
# Max total attempts per business phone across BOTH touch types.
MAX_ATTEMPTS_TOTAL=4
# Delays between retryable attempts (no-answer/busy), e.g. 1d,3d,7d.
RETRY_SCHEDULE=1d,3d,7d
# Minimum delay before a webhook-triggered second touch (default: not same-day).
FOLLOWUP_DELAY_HOURS=20
RECORDING_ENABLED=true
RECORDING_RETENTION_DAYS=90
TRANSCRIPT_RETENTION_DAYS=365
# In two-party consent states: "disclose" (announce recording) or "no_record".
TWO_PARTY_POLICY=disclose
# NANP numbers outside the US (Canada/Caribbean) are blocked unless true.
ALLOW_NON_US_NANP=false

# ---------------------------------------------------------------------------
# Cost tracking (first-class requirement)
RATES_PATH=config/rates.json

# ---------------------------------------------------------------------------
# Misc
# Slack/Discord-compatible webhook for operational alerts (number benched,
# orphaned attempts, kill switch engaged). Optional.
ALERT_WEBHOOK_URL=
# Named opener A/B variants; tracked per call. Replace with the real variant
# names when the opener scripts land.
OPENER_VARIANTS=opener_a,opener_b
PORT=8080
LOG_LEVEL=INFO
