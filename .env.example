# Aria-Swarm — environment manifest.
# Copy to `.env` and fill in. `.env*` is gitignored — never commit real secrets.
# Load it into the process environment before running `python main.py ...`.

# ============================================================================
# 1. LLM keys — REQUIRED for any live cycle
# ============================================================================
# Claude (Synthesizer, Dev Agent, adversarial judge, sensitive code).
ANTHROPIC_API_KEY=
# API model id for the "claude" specialist (accounts differ on Sonnet access).
CLAUDE_MODEL=claude-sonnet-4-6

# Hermes 3 fleet (Visionary, Saving-Mode workers, mutation operator).
# Provider chosen below = Together AI.
TOGETHER_API_KEY=
# Force the Hermes host explicitly (else inferred from whichever key is present).
HERMES_PROVIDER=together
# Optional: override the Together model slugs if the hosted ids differ.
# HERMES_70B_SLUG=NousResearch/Hermes-3-Llama-3.1-70B
# HERMES_8B_SLUG=NousResearch/Hermes-3-Llama-3.1-70B
# OpenRouter is the alternative provider (leave blank when using Together):
# OPENROUTER_API_KEY=

# ============================================================================
# 2. On-chain wallet (Coinbase CDP) — REQUIRED for real money
# ============================================================================
# Network defaults to base-mainnet. Set TESTNET=true for base-sepolia instead.
# TESTNET=true
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# ============================================================================
# 3. Creator identity
# ============================================================================
# Your PUBLIC wallet address — receives the Phase-2 dividend; read-only audit.
CREATOR_AUDIT_KEY=

# ============================================================================
# 4. Funding & budget (seed the genesis treasury)
# ============================================================================
SEED_CAPITAL_USDC=0            # initial treasury booked into wallet_balance_usdc
AUTO_MODE_BUDGET_USD=0         # spend wall for --auto; at 0, --auto halts immediately
REPLICATION_THRESHOLD_USDC=5000  # wallet size that triggers child replication

# ============================================================================
# 5. Identity key storage
# ============================================================================
# Encrypts the bootstrap-generated EVM key as a keystore JSON (recommended).
BOOTSTRAP_KEYSTORE_PASSWORD=

# ============================================================================
# 6. Optional / tuning
# ============================================================================
# SWARM_PLASMID_POOL=/shared/volume/shared_plasmid_pool.db  # cross-swarm HGT pool
# AKASH_HERMES_BASE_URL=        # only for the Immortality Protocol self-host
# TOGETHER_BASE_URL=https://api.together.xyz/v1  # already the default

# ============================================================================
# Manual steps secrets can't cover:
#   - Fund the bootstrap wallet address (~/.automaton/wallet.json) with seed
#     USDC on Base; SEED_CAPITAL_USDC mirrors it into state (a one-time on-chain
#     balance sync overwrites it when the operational wallet comes up ready).
#   - `pip install solana` — the CDP wallet's solana submodule is otherwise
#     incomplete (operational_wallet reports "pending").
# ============================================================================
