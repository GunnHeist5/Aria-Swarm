# systemd unit for the Aria Pharma app (production serving — no --reload).
# Install:
#   sudo cp deploy/pharma.service /etc/systemd/system/pharma.service
#   (edit WorkingDirectory/ExecStart paths if your clone lives elsewhere)
#   sudo systemctl daemon-reload && sudo systemctl enable --now pharma
# Logs: journalctl -u pharma -f

[Unit]
Description=Aria Pharma app
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/root/Aria-Swarm/pharma
ExecStart=/root/Aria-Swarm/pharma/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8100
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
