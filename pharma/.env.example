# Names only — real values live in an untracked .env (or the host environment).

# Anthropic API key. The org must be configured for zero-data-retention before
# real client data flows (contractual/org-level — not an API parameter).
ANTHROPIC_API_KEY=

# Model for the analyst loop and training distillation.
PHARMA_MODEL=claude-opus-5

# Secret for signing session cookies. Required — the app refuses to start
# sessions without it. Generate: python -c "import secrets; print(secrets.token_hex(32))"
PHARMA_SECRET_KEY=

# Data root (control.db, knowledge.db, per-tenant dirs). Default: pharma/var
# PHARMA_DATA_DIR=

# Set to 1 once the app is served over HTTPS (Cloudflare tunnel) so session
# cookies are HTTPS-only. Leave unset for local/SSH-tunnel testing.
# PHARMA_COOKIE_SECURE=1
